{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clproxy2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8df28c4f-832a-4f58-a5df-b112465de571","database_name": "clproxy2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "220fecbabd16432e9107451696185237" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
